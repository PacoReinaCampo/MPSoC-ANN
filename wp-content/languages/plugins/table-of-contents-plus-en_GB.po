#. translators: example anchor prefixes when no ascii characters match
#: toc.php:1002
msgid "Eg: i, toc_index, index, _"
msgstr "Eg: i, toc_index, index, _"

#: toc.php:999
msgid "This option normally applies to content written in character sets other than ASCII."
msgstr "This option normally applies to content written in character sets other than ASCII."

#: toc.php:998
msgid "Anchor targets are restricted to alphanumeric characters as per HTML specification (see readme for more detail). The default anchor prefix will be used when no characters qualify. When left blank, a number will be used instead."
msgstr "Anchor targets are restricted to alphanumeric characters as per HTML specification (see readme for more detail). The default anchor prefix will be used when no characters qualify. When left blank, a number will be used instead."

#: toc.php:995
msgid "Default anchor prefix"
msgstr "Default anchor prefix"

#. translators: example URL path restriction
#: toc.php:991
msgid "Eg: /wiki/, /corporate/annual-reports/"
msgstr "Eg: /wiki/, /corporate/annual-reports/"

#: toc.php:988
msgid "Restrict generation of the table of contents to pages that match the required path. This path is from the root of your site and always begins with a forward slash."
msgstr "Restrict generation of the table of contents to pages that match the required path. This path is from the root of your site and always begins with a forward slash."

#: toc.php:985
msgid "Restrict path"
msgstr "Restrict path"

#: toc.php:981
msgid "If you have a consistent menu across the top of your site, you can adjust the top offset to stop the headings from appearing underneath the top menu. A setting of 30 accommodates the WordPress admin bar. This setting appears after you have enabled smooth scrolling from above."
msgstr "If you have a consistent menu across the top of your site, you can adjust the top offset to stop the headings from appearing underneath the top menu. A setting of 30 accommodates the WordPress Toolbar. This setting appears after you have enabled smooth scrolling from above."

#: toc.php:978
msgid "Smooth scroll top offset"
msgstr "Smooth scroll top offset"

