msgid "[{site_title}] Automatic payment failed for {order_number}. Customer asked to authenticate payment and will be notified again {retry_time}"
msgstr "[{site_title}] Ha fallat el pagament automàtic de la comanda {order_number}. Se li demanarà al client la identificació per al pagament i serà avisat de nou en {retry_time}"

